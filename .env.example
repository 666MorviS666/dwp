# Скопируйте в .env и подставьте свои значения. Файл .env в git не едет
# (см. .gitignore) — ключи не должны попасть в репозиторий даже приватный:
# история git переживает и удаление файла, и смену видимости репозитория.

# ОБЯЗАТЕЛЬНО для лайва: список идущих матчей и поминутное состояние.
# Получить: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Необязательно: статистика пар (контры и синергии) для блока «почему».
# Без него панель берёт запасной источник OpenDota, на котором вопрос
# «кто кого контрит» статистически не имеет ответа (~81 матч на пару).
# Получить: https://stratz.com/api
STRATZ_TOKEN=

# Необязательно: поднимает лимит запросов при сборе матчей (dwp.collect).
OPENDOTA_API_KEY=

# Необязательно: корень проекта, если data/ и models/ лежат не рядом с
# пакетом. По умолчанию — каталог на уровень выше dwp/.
# DWP_HOME=/app
