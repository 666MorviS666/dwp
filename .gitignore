# Что НЕ едет в репозиторий.
#
# Правило одно: не хранить то, что пересобирается командой, и хранить то,
# без чего свежий клон не запустится. Поэтому модели (4 МБ) и маленькие
# таблицы — в репозитории, а трёхгигабайтная выгрузка матчей — нет.

# --- секреты ---------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- сырые данные ----------------------------------------------------------
# 3.3 ГБ ответов OpenDota. Пересобирается: python -m dwp.collect --n 12500
# (часы работы и лимиты API — поэтому храните их сами, вне git).
data/matches/
# Генерируется за 3 секунды: python -m dwp.synthetic
data/synthetic/
# Кэши сетевых справочников, качаются сами при первом обращении.
data/stratz/
data/matchups/
data/assets/

# --- производные таблицы ---------------------------------------------------
# python -m dwp.export  (крупные выгрузки для офлайн-замеров)
data/export_frames.csv.gz
data/export_extras.csv.gz
# python -m dwp.bench_models  (кэш предсказаний на холдауте)
data/holdout_preds.npz
# python -m dwp.builds --table  (~25 минут)
data/comeback_rows.csv
# Прочие снимки и дампы, сделанные руками.
data/*.tmp
raw.json

# --- рабочее ---------------------------------------------------------------
# Локальные разрешения Claude Code: там абсолютные пути этой машины, другим
# они не нужны и ничего не значат. Общие настройки (.claude/settings.json)
# при этом ехать могут — они не машинно-зависимые.
.claude/settings.local.json
Снимок экрана*.png
Screenshot*.png
*.log
.DS_Store
Thumbs.db
desktop.ini
